# Google Sheet used as the CMS.
# Share the sheet as "Anyone with the link can view", then paste its ID here —
# the long string between /d/ and /edit in the sheet URL.
# Leave unset and the site renders the sample rows in data/fallback.ts.
SHEET_ID=

# Optional. Without it, subscriber counts are scraped from the public channel
# page (works, but is best-effort). With it, they come from the official API.
YOUTUBE_API_KEY=
